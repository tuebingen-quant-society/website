# Issued by the University of Tübingen identity provider team.
SAML_IDP_SSO_URL=https://idp.example.invalid/idp/profile/SAML2/Redirect/SSO
SAML_IDP_ISSUER=https://idp.example.invalid/idp/shibboleth
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Generate a dedicated key pair; keep the private key only in Vercel.
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SAML_SP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# At least 32 random bytes, for example: openssl rand -base64 48
SAML_SESSION_SECRET=
